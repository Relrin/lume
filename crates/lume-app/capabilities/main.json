{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window's local content may call. Nothing from Tauri's core plugins is granted.",
  "windows": ["main"],
  "permissions": [
    "allow-webview-info",
    "allow-probe-done",
    "allow-carrier-open",
    "allow-carrier-send",
    "allow-session-spawn",
    "allow-session-attach",
    "allow-session-kill",
    "allow-session-list",
    "allow-clipboard-read",
    "allow-clipboard-write",
    "allow-open-link",
    "allow-font-families",
    "allow-page-reply"
  ]
}
