{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "terminal",
  "description": "What the page of a window that shows terminals may call, with the system's folder picker for choosing a folder to open as a workspace. Nothing from Tauri's core plugins is granted.",
  "windows": ["w-*"],
  "permissions": [
    "allow-frame-token",
    "allow-webview-info",
    "allow-carrier-open",
    "allow-carrier-send",
    "allow-session-attach",
    "allow-clipboard-read",
    "allow-clipboard-write",
    "allow-open-link",
    "allow-font-families",
    "allow-page-reply",
    "allow-page-marks",
    "allow-page-shown",
    "allow-layout-view",
    "allow-layout-apply",
    "allow-sessions-start",
    "allow-panes-busy",
    "allow-sessions-detached",
    "allow-commands-list",
    "allow-command-run",
    "allow-config-view",
    "allow-config-set",
    "allow-config-unset",
    "allow-config-open",
    "allow-profiles-list",
    "allow-host-probe",
    "allow-background-image",
    "allow-ui-contributions",
    "allow-ui-visible",
    "allow-ui-assets",
    "allow-ui-panel-expand",
    "allow-view-opened",
    "allow-view-closed",
    "allow-view-call",
    "allow-view-state",
    "allow-view-stream-open",
    "allow-window-drag",
    "allow-window-control",
    "allow-window-state",
    "allow-workspaces-list",
    "allow-folders-list",
    "allow-rex-hosts",
    "allow-rex-hosts-look",
    "allow-rex-read",
    "allow-rex-reach",
    "allow-rex-try",
    "allow-rex-host-put",
    "allow-rex-host-remove",
    "allow-ssh-reach",
    "allow-ssh-try",
    "allow-ssh-profile-put",
    "allow-profile-remove",
    "allow-profiles-listed",
    "dialog:allow-open"
  ]
}
